# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amethyst?schema=public"

# Server
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=12

# CORS: comma-separated origins (scheme + host, no path). Trailing/leading spaces OK.
# Production Firebase Hosting (required if NODE_ENV is not production default):
# CORS_ORIGIN=https://amethyst-6a511.web.app,https://amethyst-6a511.firebaseapp.com
#
# When NODE_ENV=production and CORS_ORIGIN is unset, the server defaults to the two URLs above.
# Temporary / local web debugging against the API:
# CORS_ORIGIN=*
#
# `*` is safe here: app.js maps it to dynamic origin reflection (works with credentials: true).
CORS_ORIGIN=*

# Temporary: log each login attempt (origin + path). Remove after debugging.
# LOG_INCOMING_AUTH=1
