# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amethyst?schema=public"

# Server
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=12

# CORS: comma-separated origins (no spaces required). Use * only in dev.
# Production (Firebase Hosting + optional firebaseapp.com mirror):
# CORS_ORIGIN=https://amethyst-6a511.web.app,https://amethyst-6a511.firebaseapp.com
CORS_ORIGIN=*
