rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.isActive == true;
    }

    function role() {
      return userDoc().data.role;
    }

    function isSuperAdmin() {
      return isActiveUser() && role() == 'super_admin';
    }

    function isAdmin() {
      return isActiveUser() && role() == 'admin';
    }

    function isDriver() {
      return isActiveUser() && role() == 'driver';
    }

    function isStaff() {
      return isSuperAdmin() || isAdmin();
    }

    function isAssignedDriverForVehicle(vehicleId) {
      return isDriver()
        && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.driverId
            == request.auth.uid;
    }

    function isAssignedDriverForLoad() {
      return isDriver() && (
        resource.data.driverId == request.auth.uid
        || isAssignedDriverForVehicle(resource.data.vehicleId)
      );
    }

    function canDriverMarkVehicleSaleRepaid() {
      return isDriver()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['repaidAt', 'updatedAt'])
        && (
          resource.data.driverId == request.auth.uid
          || isAssignedDriverForVehicle(resource.data.vehicleId)
        );
    }

    match /users/{userId} {
      // السماح بقراءة أسماء السوبر أدمن/الأدمن (مثلاً عند عرض ملاحظة واردة).
      allow get: if isActiveUser() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (isAdmin() && resource.data.role in ['admin', 'driver'])
        || resource.data.role in ['super_admin', 'admin']
      );
      allow list: if isActiveUser() && (isSuperAdmin() || isAdmin());
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if isActiveUser();
      allow create, delete: if isSuperAdmin() || isAdmin();
      // السائق يعدّل مخزون المحطة فقط: خصم عند البيع، زيادة عند الإرجاع.
      allow update: if isSuperAdmin() || isAdmin()
        || (isDriver()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['stationStock', 'updatedAt'])
            && request.resource.data.stationStock is int
            && resource.data.stationStock is int
            && request.resource.data.stationStock != resource.data.stationStock);
    }

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    match /vehicle_loads/{loadId} {
      allow read: if isActiveUser();
      allow create: if isStaff() || isDriver();
      allow update: if isStaff() || isAssignedDriverForLoad();
    }

    match /station_sales/{saleId} {
      allow read: if isStaff();
      allow create: if isStaff();
    }

    match /station_debt_entries/{entryId} {
      allow read: if isActiveUser();
      allow create: if isStaff() || isDriver();
      allow update: if isStaff() || (isDriver() && resource.data.recordedById == request.auth.uid);
    }

    match /vehicle_sales/{saleId} {
      allow read: if isActiveUser();
      allow create: if isDriver() || isStaff();
      allow update: if isStaff() || canDriverMarkVehicleSaleRepaid();
    }

    match /staff_notes/{noteId} {
      allow read: if isActiveUser()
        && (isStaff() || resource.data.toUserId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isActiveUser() && resource.data.toUserId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
    }

    match /stock_movements/{movementId} {
      allow read: if isStaff();
      allow create: if isActiveUser();
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isActiveUser();
    }

    match /station_cash_balance/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /station_cash_entries/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff();
    }
  }
}
